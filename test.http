### 13. Login — expect 200 with access_token, id_token, refresh_token
# Copy the access_token from the response into @accessToken at the top of this file
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "testuser123",
  "password": "SecurePassword123!"
}


# ══════════════════════════════════════════════════════════════════════════════
# LOGIN — error cases
# ══════════════════════════════════════════════════════════════════════════════

### 14. Wrong password — expect 401
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "testuser123",
  "password": "WrongPassword123!"
}

### 15. Non-existent user — expect 401
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "doesnotexist",
  "password": "SecurePassword123!"
}

### 16. Missing username — expect 400
POST {{baseUrl}}/login
Content-Type: application/json

{
  "password": "SecurePassword123!"
}

### 17. Missing password — expect 400
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "testuser123"
}


# ══════════════════════════════════════════════════════════════════════════════
# /v1/me — authenticated endpoint
# Paste your access_token into @accessToken at the top before running these.
# ══════════════════════════════════════════════════════════════════════════════

### 18. GET /v1/me — valid token — expect 200 with user profile
GET {{baseUrl}}/v1/me
Authorization: Bearer {{accessToken}}

### 19. GET /v1/me — no token — expect 401
GET {{baseUrl}}/v1/me

### 20. GET /v1/me — malformed token — expect 401
GET {{baseUrl}}/v1/me
Authorization: Bearer this.is.not.a.valid.jwt

### 21. GET /v1/me — wrong scheme (Basic instead of Bearer) — expect 401
GET {{baseUrl}}/v1/me
Authorization: Basic dXNlcjpwYXNz


# ══════════════════════════════════════════════════════════════════════════════
# DEVICES
# Requires:
#   1. @accessToken set above (from step 13 login)
#   2. A row in vpn_servers (see seed query below)
#   3. KMS_KEY_ARN set in .env
#
# Seed a VPN server row in psql first:
#   INSERT INTO vpn_servers (region, endpoint, public_key, subnet, ec2_instance_id, secret_arn)
#   VALUES ('ap-southeast-1', '1.2.3.4:51820', 'PLACEHOLDER_SERVER_PUBKEY',
#           '10.8.0.0/24', 'i-00000000000000000', 'arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:placeholder');
# ══════════════════════════════════════════════════════════════════════════════

### 22. Register a device — expect 201 with config field containing .conf content
POST {{baseUrl}}/v1/devices
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "My MacBook"
}

### 23. Register a second device — expect 201 with a different vpn_ip (.3)
POST {{baseUrl}}/v1/devices
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "My iPhone"
}

### 24. Register device — missing name — expect 400
POST {{baseUrl}}/v1/devices
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### 25. Register device — no token — expect 401
POST {{baseUrl}}/v1/devices
Content-Type: application/json

{
  "name": "Ghost Device"
}

### 26. List devices — expect 200 with array of 2 devices
GET {{baseUrl}}/v1/devices
Authorization: Bearer {{accessToken}}

### 27. Download config for device — paste device_id from step 22 response
# @name getConfig
GET {{baseUrl}}/v1/vpn/config/a40342cb-219d-4a05-892c-3a2e3f965da2
Authorization: Bearer {{accessToken}}

### 28. Revoke a device — paste device_id from step 23 response
DELETE {{baseUrl}}/v1/devices/a40342cb-219d-4a05-892c-3a2e3f965da2
Authorization: Bearer {{accessToken}}

### 29. List devices after revoke — expect 200 with 1 device remaining
GET {{baseUrl}}/v1/devices
Authorization: Bearer {{accessToken}}
