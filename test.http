# ══════════════════════════════════════════════════════════════════════════════
# REGISTER — happy path
# ══════════════════════════════════════════════════════════════════════════════

### 2. Register primary test user — expect 201
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "testuser@example.com",
  "username": "testuser123",
  "password": "SecurePassword123!"
}

### 3. Register a second user — expect 201
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "username": "newuser456",
  "password": "AnotherSecure789!"
}


# ══════════════════════════════════════════════════════════════════════════════
# REGISTER — validation errors (all expect 400)
# ══════════════════════════════════════════════════════════════════════════════

### 4. Missing email — expect 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "testuser",
  "password": "SecurePassword123!"
}

### 5. Missing username — expect 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "SecurePassword123!"
}

### 6. Missing password — expect 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "testuser"
}

### 7. Invalid email format — expect 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "not-an-email",
  "username": "testuser",
  "password": "SecurePassword123!"
}

### 8. Username too short (< 3 chars) — expect 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "ab",
  "password": "SecurePassword123!"
}

### 9. Password too short (< 8 chars) — expect 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "testuser",
  "password": "Short1!"
}

### 10. Weak password — no uppercase — expect 400 from Cognito
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "weakpwtest1",
  "password": "weakpassword123!"
}

### 11. Weak password — no special characters — expect 400 from Cognito
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "weakpwtest2",
  "password": "WeakPassword123"
}


# ══════════════════════════════════════════════════════════════════════════════
# REGISTER — conflict
# ══════════════════════════════════════════════════════════════════════════════

### 12. Duplicate username — expect 409 on second call
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "duplicate@example.com",
  "username": "testuser123",
  "password": "SecurePassword123!"
}


