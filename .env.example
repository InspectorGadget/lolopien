# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1

# ── Cognito ───────────────────────────────────────────────────────────────────
# Found in: AWS Console → Cognito → User Pools → <your pool> → App clients
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave blank if your app client has no secret configured
COGNITO_CLIENT_SECRET=

# ── KMS ───────────────────────────────────────────────────────────────────────
# ARN of the KMS symmetric key used for device private key envelope encryption.
# Create one in: AWS Console → KMS → Customer managed keys → Create key (Symmetric, Encrypt/Decrypt)
KMS_KEY_ARN=arn:aws:kms:ap-southeast-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the docker-compose.yml defaults. Change for staging/prod.
DATABASE_URL=postgres://lolopien:lolopien@localhost:5432/lolopien?sslmode=disable
