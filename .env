# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1

# ── Cognito ───────────────────────────────────────────────────────────────────
# Found in: AWS Console → Cognito → User Pools → <your pool> → App clients
COGNITO_USER_POOL_ID=ap-southeast-1_3UCq0f3fv
COGNITO_CLIENT_ID=6cqgnelbtmonfieqbad9v928lh

# Leave blank if your app client has no secret configured
COGNITO_CLIENT_SECRET=nif4cu4qj179ua4opvrj3qhkbgrkbh7l6bth6jcchi13c5bcsgb

# ── KMS ───────────────────────────────────────────────────────────────────────
# ARN of the KMS symmetric key used for device private key envelope encryption.
# Create one in: AWS Console → KMS → Customer managed keys → Create key (Symmetric, Encrypt/Decrypt)
KMS_KEY_ARN=arn:aws:kms:ap-southeast-1:649910780993:key/mrk-59dba5fee430431388189ca04da82d4d

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the docker-compose.yml defaults. Change for staging/prod.
DATABASE_URL=postgres://user:password@localhost:5432/lolopien?sslmode=disable
